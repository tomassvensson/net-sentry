# SonarQube/SonarCloud token (keep this file uncommitted when populated)
SONAR_TOKEN=

# Database URL (defaults to SQLite under the data volume)
DATABASE_URL=sqlite:///data/net-sentry.db

# Optional host configuration mounted read-only by Docker Compose.
NET_SENTRY_CONFIG_FILE=./config.yaml

# Authenticated deployments should inject these rather than commit secrets.
NET_SENTRY_JWT_SECRET=
NET_SENTRY_API_USERS_JSON={}
NET_SENTRY_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional Docker Compose host-port overrides.
NET_SENTRY_PUBLISHED_PORT=8000
PROMETHEUS_PUBLISHED_PORT=9090
GRAFANA_PUBLISHED_PORT=3000
PGADMIN_PUBLISHED_PORT=5050
SONARQUBE_PUBLISHED_PORT=9000
