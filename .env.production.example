# Public DNS name and exact browser origin. Point DNS at this host before
# starting Caddy so it can obtain and renew the certificate automatically.
NET_SENTRY_PUBLIC_HOST=net-sentry.example.com
NET_SENTRY_CORS_ORIGINS=https://net-sentry.example.com
ACME_EMAIL=security@example.com

# Dedicated Caddy-to-application network. Change this only if it overlaps an
# existing Docker network; the same CIDR scopes Uvicorn's trusted proxy peers.
NET_SENTRY_PROXY_CIDR=172.31.255.0/24

# Host files mounted as Compose secrets. Do not put secret values in this file.
NET_SENTRY_JWT_SECRET_HOST_FILE=./secrets/net_sentry_jwt_secret.txt
NET_SENTRY_API_USERS_HOST_FILE=./secrets/net_sentry_api_users.json

# Public listeners. Keep 80 reachable for ACME HTTP validation and redirects.
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PUBLISHED_PORT=80
CADDY_HTTPS_PUBLISHED_PORT=443
